<?xml version="1.0" encoding="utf-8"?>
<!-- MSI-Paket fuer MultiSnip. Gebaut von installer\build-msi.ps1 bzw. der
     Release-Workflow; Version und Plattform kommen als candle-Variablen herein. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?if $(var.Platform) = x64 ?>
    <?define Win64Flag = "yes" ?>
    <?define ProgramFilesDir = "ProgramFiles64Folder" ?>
    <?define PackagePlatform = "x64" ?>
  <?else ?>
    <?define Win64Flag = "no" ?>
    <?define ProgramFilesDir = "ProgramFilesFolder" ?>
    <?define PackagePlatform = "x86" ?>
  <?endif ?>

  <Product Id="*"
           Name="MultiSnip"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="bjwe"
           UpgradeCode="913A0A12-1CED-450B-8FF7-89F9DB329701">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="$(var.PackagePlatform)"
             Description="MultiSnip - stacking snipping tool for Windows"
             Manufacturer="bjwe" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of MultiSnip is already installed. Remove it first to install this version." />

    <!-- OCR nutzt Windows.Media.Ocr, das braucht mindestens Windows 10 1809. -->
    <Condition Message="MultiSnip requires Windows 10 version 1809 (build 17763) or newer.">
      <![CDATA[Installed OR (VersionNT >= 603 AND WindowsBuild >= 17763)]]>
    </Condition>

    <!-- Die EXE liegt im Tray und haelt sich selbst beim Schliessen am Leben,
         darum wird ein laufender Prozess vor dem Ersetzen beendet. -->
    <util:CloseApplication Id="CloseMultiSnip"
                           Target="MultiSnip.exe"
                           Description="MultiSnip is running and will be closed before the files are replaced."
                           CloseMessage="no"
                           TerminateProcess="1"
                           RebootPrompt="no" />

    <Icon Id="MultiSnipIcon" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="MultiSnipIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bjwe/multisnip" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bjwe/multisnip/issues" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.ProgramFilesDir)">
        <Directory Id="INSTALLFOLDER" Name="MultiSnip" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="$(var.Win64Flag)">
        <File Id="MultiSnipExe"
              Name="MultiSnip.exe"
              Source="$(var.ExeSource)"
              KeyPath="yes" />
      </Component>
      <!-- Je eine Komponente pro unversionierter Datei, damit Guid="*" greift
           (der Wert haengt dann an Zielordner plus Keypath und unterscheidet
           sich dadurch automatisch zwischen x86 und x64). -->
      <Component Id="LicenseFile" Guid="*" Win64="$(var.Win64Flag)">
        <File Id="LicenseTxt" Name="LICENSE.txt" Source="$(var.LicenseSource)" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFile" Guid="*" Win64="$(var.Win64Flag)">
        <File Id="ReadmeMd" Name="README.md" Source="$(var.ReadmeSource)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="$(var.Win64Flag)">
        <Shortcut Id="MultiSnipStartMenuShortcut"
                  Name="MultiSnip"
                  Description="Stacking snipping tool for Windows"
                  Target="[#MultiSnipExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\bjwe\MultiSnip"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="MultiSnip" Level="1" Absent="disallow">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Oberflaeche: Lizenz, Zielordner, am Ende optional starten. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtfSource)" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch MultiSnip" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MultiSnipExe]" />
    <CustomAction Id="LaunchMultiSnip"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMultiSnip" Order="1">
        <![CDATA[WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed]]>
      </Publish>
    </UI>

  </Product>
</Wix>
